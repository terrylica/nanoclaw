#!/usr/bin/env bash
#MISE description="Phase 1: Pre-release checks (clean git, auth, dependencies)"

set -euo pipefail

echo "→ Preflight checks"
echo ""

# 1. Check working directory is clean
echo "Checking git working directory..."
DIRTY=$(git status --porcelain)
if [[ -n "$DIRTY" ]]; then
    echo "FAIL: Uncommitted changes detected:"
    echo "$DIRTY"
    exit 1
fi

# 2. Check not ahead of upstream
echo "Checking for unpushed commits..."
UNPUSHED=$(git log --oneline @{u}..HEAD 2>/dev/null || echo "")
if [[ -n "$UNPUSHED" ]]; then
    echo "FAIL: Unpushed commits found:"
    echo "$UNPUSHED"
    exit 1
fi

# 3. Check on main branch
BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [[ "$BRANCH" != "main" ]]; then
    echo "FAIL: Not on main branch (currently: $BRANCH)"
    exit 1
fi

# 4. Verify semantic-release is installed (deps should already be committed)
if ! npm ls semantic-release >/dev/null 2>&1; then
    echo "FAIL: semantic-release not installed. Run: npm install"
    exit 1
fi

# 5. Verify GH_TOKEN is available for GitHub release creation
if [[ -z "${GH_TOKEN:-}" ]] && ! gh auth status >/dev/null 2>&1; then
    echo "FAIL: No GitHub authentication (set GH_TOKEN or run gh auth login)"
    exit 1
fi

# 6. Verify TypeScript compiles
echo "Checking TypeScript compilation..."
npx tsc --noEmit

# 7. Reset lockfile drift (artifact from prior npm/uv/cargo operations)
LOCKFILE_DRIFT=$(git diff --name-only | grep -E '^(package-lock\.json|pnpm-lock\.yaml|yarn\.lock|bun\.lockb)$' || true)
if [[ -n "$LOCKFILE_DRIFT" ]]; then
    echo "Resetting lockfile drift (build artifact)"
    echo "$LOCKFILE_DRIFT" | xargs git checkout --
fi

echo "Node.js version: $(node -v)"
echo ""
echo "✓ Preflight PASSED — ready to release"
