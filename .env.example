# NanoClaw Continuous Validation System
# Copy to .env and fill in values

# --- Required ---

# Telegram bot token (from @BotFather) — use @bbgpu_bot for NanoClaw
TELEGRAM_BOT_TOKEN=

# Telegram chat ID (your personal chat with the bot)
TELEGRAM_CHAT_ID=

# MiniMax API key (outer orchestrator inference)
MINIMAX_API_KEY=

# Claude Code OAuth token (for `claude -p` validation)
# Generate via: claude setup-token (valid 1 year)
CLAUDE_CODE_OAUTH_TOKEN=

# --- Optional ---

# Bot display name (default: NanoClaw)
ASSISTANT_NAME=NanoClaw

# Timezone (default: America/Vancouver)
TZ=America/Vancouver

# Log level: trace, debug, info, warn, error, fatal (default: info)
LOG_LEVEL=info

# Container settings
CONTAINER_IMAGE=nanoclaw-agent:slim
CONTAINER_TIMEOUT=1800000
IDLE_TIMEOUT=300000
MAX_CONCURRENT_CONTAINERS=2

# Path to opendeviationbar-py clone on bigblack
ODB_REPO_PATH=~/eon/opendeviationbar-py

# GitHub owner/repo for issue creation (auto-detected from git remote if omitted)
GITHUB_REPO=terrylica/opendeviationbar-py

# Path to cc-skills repo for issue templates and label patterns
# Synced via git pull on startup and every heartbeat (30 min)
CC_SKILLS_PATH=~/eon/cc-skills
